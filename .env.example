# Copy to .env (git-ignored) and adjust. Never put real production
# credentials in this file.

# ---- Server ----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# ---- Database (required) ---------------------------------------------------
# ShadowChat uses temporary PostgreSQL persistence: active rooms and their
# recent messages survive a backend restart, and everything is deleted when the
# room expires.
#
# These are local development placeholders. docker-compose.yml reads the same
# variables, so setting them here configures both the app and the container.
POSTGRES_USER=shadowchat
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=shadowchat
POSTGRES_PORT=5432

# Must match the values above. Use `@db:5432` inside Docker Compose,
# `@localhost:5432` when running Node on the host.
DATABASE_URL=postgres://shadowchat:change-me-locally@localhost:5432/shadowchat

# Max pooled connections (default 10)
# PGPOOL_MAX=10

# Set to `require` for managed Postgres (Neon, Supabase, RDS) that rejects
# plaintext connections.
# PGSSL=require

# The server refuses to start without a reachable database. Set to false only
# for a throwaway demo -- rooms then live in memory and are lost on restart.
# REQUIRE_DATABASE=false

# ---- Sockets ---------------------------------------------------------------
# Optional: restrict Socket.IO CORS to one origin in production.
# Leave unset when the frontend is served from this same server.
# SOCKET_ORIGIN=https://shadowchat.example.com

# ---- Rate limiting ---------------------------------------------------------
# Room-join attempts per IP per window (brute-force protection).
# JOIN_ATTEMPTS_PER_WINDOW=10
# JOIN_RATE_WINDOW_MS=60000

# Per-connection message flood protection.
# MESSAGE_ATTEMPTS_PER_WINDOW=20
# MESSAGE_RATE_WINDOW_MS=10000

# Per-IP message flood protection. The per-connection limit alone multiplies
# with every socket a client opens, so this caps the whole client/network.
# Keyed per IPv4 address and per IPv6 /64 subnet. Process-local: with several
# app instances each process enforces its own quota.
# MESSAGE_IP_RATE=60
# MESSAGE_IP_WINDOW_MS=10000

# Enable ONLY behind a reverse proxy you control that sets X-Forwarded-For.
# Otherwise the header is spoofable and the join limiter can be bypassed.
# TRUST_PROXY=false

# ---- Room lifecycle --------------------------------------------------------
# MAX_MESSAGES_PER_ROOM=250      # cap in memory and in Postgres
# EMPTY_ROOM_TTL_MS=60000        # how long an empty room survives
# MAX_MEMBERS_PER_ROOM=50
# HYDRATE_ACTIVE_WITHIN_MS=1800000  # rooms idle longer than this are expired
# RECONNECT_GRACE_MS=10000       # a return within this window is a reconnect,
#                                # not a leave + join (keeps the timeline quiet)

# ---- Persistence tuning ----------------------------------------------------
# Bounded retry for write-behind persistence. Delay grows per attempt
# (base x attempt). After the last attempt the write is dropped and the
# persistence status reported to clients becomes "degraded".
# WRITE_MAX_ATTEMPTS=3
# WRITE_RETRY_BASE_MS=250

# How often the in-process sweeper deletes expired rooms from Postgres
# (messages follow via ON DELETE CASCADE). Uses HYDRATE_ACTIVE_WITHIN_MS as the
# expiry definition -- there is no second TTL.
# SWEEP_INTERVAL_MS=300000
